{
  "name": "Shuffll Engage - Save a creation brief without generating media",
  "nodes": [
    {
      "id": "3cba784e-b789-4014-8094-9302a3449625",
      "name": "Setup and limitations",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        -380
      ],
      "parameters": {
        "content": "## Save a creation brief\n\nSelect a private **Bearer Auth** credential containing your organization-scoped Engage API key on every HTTP node. Requires `templates:write`. Replace organizationId and idempotencyKey before running.\n\nThis saves text only. It does not generate media, export a video, activate a campaign or send messages. Keep the idempotency key for uncertain retries of the same intended brief. Inspect the returned job state and result; queued/running is not completion.",
        "height": 330,
        "width": 700,
        "color": 5
      }
    },
    {
      "id": "7cb0df7e-3e00-46b3-aabf-a8c83ccedcb5",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "02b122f4-5684-4a8c-9536-13075f316ada",
      "name": "Brief inputs",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "fedc2b2e-c431-45d3-8591-da1724185da2",
              "name": "organizationId",
              "value": "REPLACE_WITH_ORGANIZATION_UUID",
              "type": "string"
            },
            {
              "id": "422a85c6-c319-4e5c-87e7-9696b46cb3ef",
              "name": "title",
              "value": "Northstar Demo welcome concept",
              "type": "string"
            },
            {
              "id": "c0870304-3cd6-4e4e-9cde-c4bd5f92e788",
              "name": "brief",
              "value": "Create a short welcome video concept for fictional Northstar Demo. Save this text brief only; do not generate or send media.",
              "type": "string"
            },
            {
              "id": "4157a088-378a-411c-a334-0a7a7b67985c",
              "name": "language",
              "value": "en",
              "type": "string"
            },
            {
              "id": "27eb5162-b361-4bce-abad-5bbb50beb9cd",
              "name": "idempotencyKey",
              "value": "REPLACE_WITH_A_UNIQUE_KEY_FOR_THIS_BRIEF",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c7d192c5-7b9f-43fe-80dd-76986f7a1524",
      "name": "Save creation brief",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        540,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://engage.shuffll.com/api/v1/journeys",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.idempotencyKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({organization_id: $json.organizationId, title: $json.title, brief: $json.brief, language: $json.language}) }}"
      }
    }
